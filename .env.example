# Copy to .env and fill in locally. Never commit .env.

# Backend (FastAPI)
API_PORT=8000
DATABASE_URL=sqlite:///./data/stripsafe.sqlite
CORS_ORIGINS=http://localhost:5173

# CDSCO ingester (public endpoints, no key needed)
CDSCO_NSQ_BASE_URL=https://cdscoonline.gov.in/CDSCO
CDSCO_INGEST_CRON=0 6 * * *

# OCR
OCR_ENGINE=paddleocr
OCR_MIN_CONFIDENCE=0.80

# Matching
MATCH_MAX_EDIT_DISTANCE=1

# Web push (generate your own VAPID pair locally)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
